# Copy to .env.local to override. Defaults are set for "no backend running yet".
#
# WARNING: every VITE_ variable is inlined into the client bundle in plain text
# and is readable by anyone who opens the page. Never put a secret here.

# 'false' switches the API layer from fixtures to real HTTP. Anything else mocks.
VITE_USE_MOCKS=true

# Origin of the backend. Only read when VITE_USE_MOCKS=false.
VITE_API_BASE_URL=

# Which fixture variant to serve: normal | empty | large | error.
VITE_MOCK_SCENARIO=normal

# 'true' enforces the login route guard.
#
# Safe to turn on together with VITE_USE_MOCKS=true - the whole sign-in flow
# works on fixtures. Against a real backend leave it off until the login REQUEST
# body is documented (see src/api/endpoints/auth.ts), otherwise every screen
# redirects to a login that cannot succeed.
VITE_AUTH_ENFORCED=false

# Origin of WS /ws/attendance. Defaults to VITE_API_BASE_URL with http -> ws,
# which is right whenever the socket is served from the same origin.
VITE_WS_BASE_URL=

# How the JWT is presented to the WebSocket: query | subprotocol.
#
# A browser cannot set an Authorization header on a WebSocket handshake, so it
# has to be one of these two - and contracts/api.md says the socket "requires a
# valid JWT token" without saying which. Left unset on purpose: the socket then
# refuses to connect and says why, instead of guessing and failing silently.
# Ask Ahmed, then set it.
VITE_WS_AUTH_MODE=

# Query parameter name when VITE_WS_AUTH_MODE=query. The backend's call.
VITE_WS_AUTH_QUERY_PARAM=token
