# Copy to .env.local to override. Defaults are set for "no backend exists yet".
#
# WARNING: every VITE_ variable is inlined into the client bundle in plain text
# and is readable by anyone who opens the page. Never put a secret here.

# 'false' switches the API layer from fixtures to real HTTP. Anything else mocks.
VITE_USE_MOCKS=true

# Origin of the backend. Only read when VITE_USE_MOCKS=false.
VITE_API_BASE_URL=

# Which fixture variant to serve: normal | empty | large | error.
VITE_MOCK_SCENARIO=normal

# 'true' enforces the login route guard. Leave off until contracts/api.md
# defines an authentication endpoint - otherwise every screen redirects to a
# login that cannot succeed.
VITE_AUTH_ENFORCED=false
